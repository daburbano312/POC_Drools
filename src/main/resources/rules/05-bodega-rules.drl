package com.drools.poc.rules

import com.drools.poc.model.Customer
import com.drools.poc.model.LoanApplication
import com.drools.poc.model.RiskAssessment
import com.drools.poc.model.Decision

/**
 * REGLAS BODEGA (basadas en Bodegas.xlsx)
 * Matriz exhaustiva por atributo + combinaciones clave.
 *
 * Convencion de valores esperados en LoanApplication:
 * propertyCondition: NUEVO, USADO
 * propertyAgeRange: MENOR_5, ENTRE_5_20, MAYOR_20
 * propertyLocation: PARQUE_INDUSTRIAL, ZONA_FRANCA, ZONA_INDUSTRIAL, OTRA_UBICACION
 * clearHeightRange: MENOR_7, DOBLE_ALTURA, TRIPLE_ALTURA
 * accessDoorHeightRange: MENOR_3_5, ENTRE_3_5_4_5, MAYOR_4_5
 * parkingAvailability: SI, NO, INCIERTO
 * parkingIndexRange: MENOR_50, ENTRE_50_100, MAYOR_100
 * saleableAreaRange: MENOR_500, ENTRE_500_1000, ENTRE_1000_5000, MAYOR_5000
 * accessRoadType: VIA_PRINCIPAL, VIA_SECUNDARIA_BUENAS, VIA_SECUNDARIA_REGULARES
 * subleaseContractRange: PROPIO, MENOR_1, ENTRE_1_5, ENTRE_5_10, MAYOR_10
 */

// ============== MATRIZ BASE POR ATRIBUTO ==============

rule "Bodega Matrix - Condition New"
    no-loop true
    salience 260
    when
        $app: LoanApplication(assetType == "BODEGA", propertyCondition == "NUEVO")
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Matrix - Condition New");
        $risk.addRiskFactor("BODEGA_CONDITION_NEW");
        $risk.setRiskScore(Math.max(0, $risk.getRiskScore() - 3));
end

rule "Bodega Matrix - Condition Used"
    no-loop true
