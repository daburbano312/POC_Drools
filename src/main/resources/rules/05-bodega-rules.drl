rule "Bodega Critical Not Favorable Combination"
    no-loop true
    salience 190
    when
        $app: LoanApplication(
            assetType == "BODEGA",
            propertyAgeRange == "MAYOR_20",
            propertyLocation == "OTRA_UBICACION",
            clearHeightRange == "MENOR_7"
        )
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Critical Not Favorable Combination");
        $risk.addRiskFactor("BODEGA_CRITICAL_NO_FAVORABLE");
        $risk.setRiskScore($risk.getRiskScore() + 45);
        $risk.setRequiresManualReview(true);
        $risk.setRecommendedAction("MANUAL_REVIEW");
end

rule "Bodega Extreme Critical Combination"
    no-loop true
    salience 190
    when
        $app: LoanApplication(
            assetType == "BODEGA",
            propertyAgeRange == "MAYOR_20",
            propertyLocation == "OTRA_UBICACION",
            clearHeightRange == "MENOR_7",
            accessDoorHeightRange == "MENOR_3_5",
            parkingIndexRange == "MAYOR_100"
        )
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Extreme Critical Combination");
        $risk.addRiskFactor("BODEGA_EXTREME_CRITICAL");
        $risk.setRiskScore($risk.getRiskScore() + 50);
        $risk.setRequiresManualReview(true);
        $risk.setRecommendedAction("REJECT");
        $risk.setAssessmentNotes("Bodega no favorable critica (combinacion extrema)");
end

// ============== CLASIFICACION FINAL DE MATRIZ BODEGA ==============

rule "Bodega Matrix Final Classification Favorable"
    no-loop true
    salience 150
    when
        $app: LoanApplication(assetType == "BODEGA")
        $risk: RiskAssessment(applicationId == $app.applicationId, riskScore <= 20)
    then
        $risk.addAppliedRule("Bodega Matrix Final Classification Favorable");
        $risk.addRiskFactor("BODEGA_RESULT_FAVORABLE");
        if ($risk.getAssessmentNotes() == null) {
            $risk.setAssessmentNotes("Matriz bodega: resultado favorable");
        }
end

rule "Bodega Matrix Final Classification Medium"
    no-loop true
    salience 150
    when
        $app: LoanApplication(assetType == "BODEGA")
        $risk: RiskAssessment(applicationId == $app.applicationId, riskScore > 20, riskScore < 55)
    then
        $risk.addAppliedRule("Bodega Matrix Final Classification Medium");
        $risk.addRiskFactor("BODEGA_RESULT_MEDIUM");
        $risk.setRequiresManualReview(true);
        if ($risk.getAssessmentNotes() == null) {
            $risk.setAssessmentNotes("Matriz bodega: requiere concepto especialista");
        }
end

rule "Bodega Matrix Final Classification Not Favorable"
    no-loop true
    salience 150
    when
        $app: LoanApplication(assetType == "BODEGA")
        $risk: RiskAssessment(applicationId == $app.applicationId, riskScore >= 55)
    then
        $risk.addAppliedRule("Bodega Matrix Final Classification Not Favorable");
        $risk.addRiskFactor("BODEGA_RESULT_NOT_FAVORABLE");
        $risk.setRequiresManualReview(true);
        $risk.setRecommendedAction("MANUAL_REVIEW");
        if ($risk.getAssessmentNotes() == null) {
            $risk.setAssessmentNotes("Matriz bodega: no favorable");
        }
end
