// ============== COMBINACIONES CRUZADAS CLAVE (LF/PF) ==============

rule "Bodega Favorable Core Combination"
    no-loop true
    salience 205
    when
        $app: LoanApplication(
            assetType == "BODEGA",
            propertyCondition == "NUEVO",
            propertyAgeRange == "MENOR_5",
            propertyLocation == "PARQUE_INDUSTRIAL",
            (clearHeightRange == "DOBLE_ALTURA" || clearHeightRange == "TRIPLE_ALTURA"),
            accessDoorHeightRange == "MENOR_3_5",
            accessRoadType == "VIA_PRINCIPAL"
        )
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Favorable Core Combination");
        $risk.addRiskFactor("BODEGA_FAVORABLE_CORE");
        $risk.setRiskScore(Math.max(0, $risk.getRiskScore() - 12));
        $risk.setAssessmentNotes("Bodega con perfil favorable (Concepto favorable)");
end

rule "Bodega Favorable High Capacity Combination"
    no-loop true
    salience 205
    when
        $app: LoanApplication(
            assetType == "BODEGA",
            propertyCondition == "NUEVO",
            propertyLocation == "PARQUE_INDUSTRIAL",
            clearHeightRange == "TRIPLE_ALTURA",
            accessDoorHeightRange == "MAYOR_4_5",
            saleableAreaRange == "ENTRE_1000_5000",
            accessRoadType == "VIA_PRINCIPAL"
        )
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Favorable High Capacity Combination");
        $risk.addRiskFactor("BODEGA_FAVORABLE_HIGH_CAPACITY");
        $risk.setRiskScore(Math.max(0, $risk.getRiskScore() - 10));
        $risk.setAssessmentNotes("Bodega favorable para operacion de alta capacidad");
end

rule "Bodega Medium Combination Requires Specialist"
    no-loop true
    salience 200
    when
        $app: LoanApplication(
            assetType == "BODEGA",
            propertyCondition == "USADO",
            propertyAgeRange == "ENTRE_5_20",
            (propertyLocation == "ZONA_FRANCA" || propertyLocation == "ZONA_INDUSTRIAL"),
            clearHeightRange == "DOBLE_ALTURA",
            accessDoorHeightRange == "ENTRE_3_5_4_5"
        )
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Medium Combination Requires Specialist");
        $risk.addRiskFactor("BODEGA_REQUIRES_SPECIALIST");
        $risk.setRiskScore($risk.getRiskScore() + 10);
        $risk.setRequiresManualReview(true);
        $risk.setAssessmentNotes("Bodega en perfil medio: requiere concepto especialista");
end

rule "Bodega Medium Legacy Combination"
    no-loop true
    salience 200
    when
        $app: LoanApplication(
            assetType == "BODEGA",
            propertyCondition == "USADO",
            propertyAgeRange == "MAYOR_20",
            propertyLocation == "ZONA_INDUSTRIAL",
            clearHeightRange == "DOBLE_ALTURA",
            accessRoadType == "VIA_SECUNDARIA_BUENAS"
        )
        $risk: RiskAssessment(applicationId == $app.applicationId)
    then
        $risk.addAppliedRule("Bodega Medium Legacy Combination");
        $risk.addRiskFactor("BODEGA_MEDIUM_LEGACY");
        $risk.setRiskScore($risk.getRiskScore() + 12);
        $risk.setRequiresManualReview(true);
        if ($risk.getAssessmentNotes() == null) {
            $risk.setAssessmentNotes("Combinacion media de legado: requiere especialista");
        }
end

rule "Bodega Not Favorable Old And Very Large"
